{
  "name": "atiny-atlas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:bdd && pnpm test:unit",
    "test:unit": "vitest run tests/unit",
    "test:bdd": "node scripts/run-db-suite.mjs cucumber-js --config cucumber.mjs",
    "test:integration": "node scripts/run-db-suite.mjs vitest run tests/integration",
    "test:contract": "node scripts/run-db-suite.mjs vitest run tests/contract",
    "test:coverage": "node scripts/run-db-suite.mjs vitest run tests/unit tests/integration --coverage",
    "test:migrations": "node scripts/test-migrations.mjs",
    "docker:up": "docker compose --profile local up --build",
    "docker:up:pro": "docker compose --profile pro up --build",
    "docker:down": "docker compose --profile local --profile pro down",
    "docker:logs": "docker compose --profile local logs --follow app-local",
    "docker:logs:pro": "docker compose --profile pro logs --follow app-pro"
  },
  "dependencies": {
    "@clerk/localizations": "4.16.1",
    "@clerk/nextjs": "7.9.2",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@react-leaflet/core": "3.0.0",
    "@tanstack/react-query": "5.104.1",
    "@vercel/config": "0.7.1",
    "jose": "6.2.12",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "next": "16.3.5",
    "next-intl": "4.14.9",
    "postgres": "3.4.9",
    "posthog-js": "1.438.1",
    "posthog-node": "5.55.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
