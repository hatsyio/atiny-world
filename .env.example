# Copia este archivo a .env para desarrollar en tu PC. No guardes valores reales
# en Git. Compose sustituye DATABASE_URL por db:5432 dentro de app-local.
# Desde el host, 127.0.0.1:54332 apunta al PostgreSQL de Docker Compose.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Clerk de desarrollo: pk_test_ y sk_test_. Ambos perfiles de Compose se
# ejecutan en localhost y usan esta misma instancia para login y autorización.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clave pública del mapa CARTO y clave de Geoapify usada solo por el servidor.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
GEOAPIFY_API_KEY=

# Analítica de producto PostHog. Usa el token público de Project Settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Subida de source maps en builds Preview y Production de Vercel.
# POSTHOG_API_KEY es una clave privada: nunca uses el prefijo NEXT_PUBLIC_.
# Permisos: error_tracking:write y organization:read.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=651528

# Secretos estables y aleatorios. No reutilices los de otros entornos.
# LOCATION_SELECTION_SECRET firma las selecciones de ubicación.
# CURSOR_SECRET firma los cursores de paginación del mapa.
LOCATION_SELECTION_SECRET=
CURSOR_SECRET=

# Opcionales hasta configurar el webhook de Clerk y el cron de borrado.
# CLERK_WEBHOOK_SECRET valida firmas de eventos entrantes de Clerk.
# CRON_SECRET autentica el endpoint del cron de producción.
CLERK_WEBHOOK_SECRET=
CRON_SECRET=

# Pruebas con Supabase CLI: TEST_DATABASE_URL es opcional. Si no se define,
# scripts/run-db-suite.mjs usa 127.0.0.1:54322; no se carga desde este archivo.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Crea .env.pro por separado con estas dos líneas. Compose carga .env primero
# y .env.pro después; por tanto, conserva las claves locales de Clerk y cambia
# únicamente la conexión PostgreSQL. La cuenta de aplicación debe tener permisos
# limitados. No uses la contraseña administrativa en DATABASE_URL.
# Runtime en Vercel: Supavisor transaccional (6543); no conversión automática.
# Migraciones/admin: conexión directa o sesión 5432 independiente.
# DATABASE_URL=postgresql://<usuario_app>:<password>@<host_pooler>:6543/postgres
# SUPABASE_DB_PASSWORD=<password_administrativa_solo_para_la_CLI>

# Opcional: origen público del dominio propio para canonical. Si no se define,
# usa VERCEL_PROJECT_PRODUCTION_URL en Vercel o http://localhost:3000 en local.
# SITE_URL=https://tu-dominio.example

# Caché compartida de lecturas públicas. Desactivada por defecto; antes de activar,
# revisar docs/runtime-cache.md (cuota compartida, coste y aislamiento de BD).
# Solo cachea lecturas en Vercel Production (VERCEL=1, VERCEL_ENV=production),
# con VERCEL_PROJECT_ID presente. Preview/desarrollo leen siempre la BD.
PUBLIC_READ_CACHE_ENABLED=false
PUBLIC_READ_CACHE_GEOGRAPHY_TTL_SECONDS=86400
PUBLIC_READ_CACHE_OPTIONS_TTL_SECONDS=300
PUBLIC_READ_CACHE_STATS_TTL_SECONDS=60

# Invalidación de Production después de escrituras desde Preview/desarrollo que
# apunten a la misma BD remota. Independiente de PUBLIC_READ_CACHE_ENABLED.
# Production requiere el secreto; cada escritor requiere URL HTTPS completa y
# el mismo secreto (32–256 caracteres ASCII imprimibles, sin espacios).
# En Compose, definir SOLO en .env.pro, nunca en .env con la BD local aislada.
# PUBLIC_READ_CACHE_INVALIDATION_URL=https://tu-dominio.example/api/internal/cache/invalidate
PUBLIC_READ_CACHE_INVALIDATION_URL=
PUBLIC_READ_CACHE_INVALIDATION_SECRET=
