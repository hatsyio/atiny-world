# Copia este archivo a .env para desarrollar en tu PC. No guardes valores reales
# en Git. Compose sustituye DATABASE_URL por db:5432 dentro de app-local.
# Desde el host, 127.0.0.1:54332 apunta al PostgreSQL de Docker Compose.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Clerk de desarrollo: pk_test_ y sk_test_. Ambos perfiles de Compose se
# ejecutan en localhost y usan esta misma instancia para login y autorización.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clave pública del mapa CARTO y clave de Geoapify usada solo por el servidor.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
GEOAPIFY_API_KEY=

# Secretos estables y aleatorios. No reutilices los de otros entornos.
# LOCATION_SELECTION_SECRET firma las selecciones de ubicación.
# CURSOR_SECRET firma los cursores de paginación del mapa.
LOCATION_SELECTION_SECRET=
CURSOR_SECRET=

# Opcionales hasta configurar el webhook de Clerk y el cron de borrado.
# CLERK_WEBHOOK_SECRET valida firmas de eventos entrantes de Clerk.
# CRON_SECRET autentica el endpoint del cron de producción.
CLERK_WEBHOOK_SECRET=
CRON_SECRET=

# Pruebas con Supabase CLI: TEST_DATABASE_URL es opcional. Si no se define,
# scripts/run-db-suite.mjs usa 127.0.0.1:54322; no se carga desde este archivo.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Crea .env.pro por separado con estas dos líneas. Compose carga .env primero
# y .env.pro después; por tanto, conserva las claves locales de Clerk y cambia
# únicamente la conexión PostgreSQL. La cuenta de aplicación debe tener permisos
# limitados. No uses la contraseña administrativa en DATABASE_URL.
# DATABASE_URL=postgresql://<usuario_app>:<password>@<host_remoto>:5432/postgres
# SUPABASE_DB_PASSWORD=<password_administrativa_solo_para_la_CLI>
