# CARTO Basemaps key. This value is exposed to the browser and must be
# restricted to the allowed application domains in CARTO.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=

# Geoapify key. Keep it server-only and use it from backend route handlers.
GEOAPIFY_API_KEY=

# PostgreSQL URL used only by the Next.js server. For local Supabase use
# postgresql://postgres:postgres@127.0.0.1:54322/postgres.
DATABASE_URL=

# Clerk is provisioned through the Vercel Marketplace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Svix). Server-only; used to verify
# signed events such as user.deleted.
CLERK_WEBHOOK_SECRET=

# Secret bearer token for the production-only account-deletion retry
# endpoint invoked by the daily cron. Server-only.
CRON_SECRET=

# Secret used to sign short-lived, opaque location-selection tokens.
# Server-only; never shares addresses or provider payloads.
LOCATION_SELECTION_SECRET=

# Secret used to sign stable pagination cursors for the public map API.
# Server-only. Required in production. When unset in development, an ephemeral
# per-process key is used.
CURSOR_SECRET=
